<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Definizione delle sorgenti dei pacchetti -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" allowInsecureConnections="True" />
    <!-- Qui ci saranno anche le tue altre sorgenti (DevExpress, DevSecOps, ecc.) -->
  </packageSources>

  <!-- Configurazione delle mappature (Package Source Mapping) -->
  <packageSourceMapping>
    <!-- Mappa nuget.org per i pacchetti System.* -->
    <packageSource key="nuget.org">
      <package pattern="System.*" />
      <package pattern="Microsoft.*" />
      <package pattern="Fody" />
      <package pattern="Newtonsoft.Json" />
      <package pattern="PropertyChanged.Fody" />
      <package pattern="runtime.native.System.Data.SqlClient.sni" />
      <package pattern="runtime.win-arm64.runtime.native.System.Data.SqlClient.sni" />
      <package pattern="runtime.win-x64.runtime.native.System.Data.SqlClient.sni" />
      <package pattern="runtime.win-x86.runtime.native.System.Data.SqlClient.sni" />
    </packageSource>
    
    <!-- Esempio per le tue sorgenti aziendali o terze parti -->
    <!--
    <packageSource key="DevExpress 25.2 Local">
      <package pattern="DevExpress.*" />
    </packageSource>
    -->
  </packageSourceMapping>
</configuration>
